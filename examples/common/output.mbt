///|
/// Shared output destinations and export flags for the showcase examples.
///
/// Each example builds its own geometry options, calls `with_output_args` to
/// add the standard export flags, then calls `write_output` with the assembled
/// `Component`.

///|
pub(all) struct OutputPaths {
  step : String?
  assembly : String?
  assembly_instanced : String?
  eval : String?
  gltf : String?
  bpy : String?
  blender : String?
  blend : String?
  urdf : String?
  bundle : String?
  bom : String?
  plan : String?
  report : String?
  control : String?
  pins : String?
  build_package : String?
  print_parts : String?
  posed_parts : String?
  detail : String
  process : String
  fdm : Bool
  threads : String
  bed_size : String
  check : Bool
  analyze : Bool
  inspect_json : Bool
  rl_task : Bool
  collisions : Bool
  validate : Bool
  validate_meshes : Bool
}

///|
/// Returns true when a design contains boolean or edge-feature nodes that the
/// flat STEP writer cannot trim.
fn design_has_boolean(design : @step_cad.Design) -> Bool {
  let mut found = false
  for node in design.nodes() {
    match node.shape {
      @step_cad.Shape::Union(_)
      | @step_cad.Shape::Difference(_)
      | @step_cad.Shape::Fillet(_)
      | @step_cad.Shape::Chamfer(_) => found = true
      _ => ()
    }
  }
  found
}

///|
/// Formats a self-documenting STEP header comment block containing the exact
/// invocation command and all component parameters (preserving any existing
/// part-level documentation).
fn build_step_documentation(comp : @cad.Component, existing : String) -> String {
  let lines : Array[String] = [
    "  Generated by the gmlewis/cad MoonBit CAD library.",
    "  Repository: https://github.com/gmlewis/moonbit-cad",
    "  Component:  " + comp.display_name(),
    "  Command:    " + @env.args().join(" "),
  ]
  if !comp.parameters.is_empty() {
    lines.push("  Parameters:")
    let keys : Array[String] = []
    comp.parameters.each(fn(k, _) { keys.push(k) })
    keys.sort()
    for k in keys {
      match comp.parameters.get(k) {
        Some(v) => lines.push("    " + k + " = " + v)
        None => ()
      }
    }
  }
  if existing != "" {
    lines.push(existing)
  }
  lines.join("\n")
}

///|
/// Writes `provenance.json` next to exported printable STEPs so downstream
/// `.3mf` mesh exports can embed the exact MoonBit command and parameters used
/// to generate the parts.
async fn write_provenance_json(dir : String, comp : @cad.Component) -> Unit {
  let argv = @env.args()
  let quoted_args = argv.map(json_quote).join(", ")
  let shell_cmd = argv.join(" ")
  let params_entries : Array[String] = []
  comp.parameters.each(fn(k, v) {
    params_entries.push(json_quote(k) + ": " + json_quote(v))
  })
  let params_json = "{" + params_entries.join(", ") + "}"
  let doc =
    $|{
    $|  "component": \{json_quote(comp.display_name())},
    $|  "command": \{json_quote(shell_cmd)},
    $|  "argv": [\{quoted_args}],
    $|  "elephant_foot_chamfer_mm": \{@cad.DEFAULT_ELEPHANT_FOOT_CHAMFER_MM},
    $|  "parameters": \{params_json}
    $|}
    $|
  @step_cad.write_text_file(doc, Some(dir + "/provenance.json"))
}

///|
/// Maximum STEP file size (bytes) for OCCT bottom-face chamfering; larger
/// multi-body B-spline cartridges (such as 30 MB swept herringbone gearsets)
/// are skipped so builds stay fast.
const MAX_CHAMFER_STEP_BYTES : Int32 = 10 * 1024 * 1024

///|
/// Applies a 45-degree bottom-face (`z = 0`) elephant-foot chamfer to a
/// printable STEP file in place via `scripts/csg_eval.py --chamfer-bottom`.
/// Fails soft with a warning if OCP is unavailable or the file exceeds
/// `MAX_CHAMFER_STEP_BYTES`.
pub async fn apply_bottom_chamfer(
  path : String,
  chamfer_mm~ : Double = @cad.DEFAULT_ELEPHANT_FOOT_CHAMFER_MM,
) -> Unit {
  if chamfer_mm <= 0.0 {
    return
  }
  let size = @fs.read_file(path).binary().length() catch { _ => 0 }
  if size <= 0 || size > MAX_CHAMFER_STEP_BYTES {
    return
  }
  let res = Some(
    @process.collect_output_merged("python3", [
      "scripts/csg_eval.py",
      path,
      "-o",
      path,
      "--chamfer-bottom",
      chamfer_mm.to_string(),
    ]),
  ) catch {
    _ => None
  }
  match res {
    Some((code, out)) =>
      if code != 0 {
        let msg = out.text() catch { _ => "" }
        let trimmed = msg.trim()
        @cli.eprintln("warning: bottom chamfer skipped for \{path}: \{trimmed}")
      }
    None =>
      @cli.eprintln(
        "warning: python3/OCP unavailable; skipped bottom chamfer for " + path,
      )
  }
}

///|
/// Writes one printable part. Parts whose geometry is a boolean or edge
/// feature are OCCT-evaluated so the printed STEP carries the trimmed solid;
/// if OCCT is unavailable the nominal export is written with a warning.
/// Applies the default 0.35 mm bottom-face elephant-foot chamfer afterward.
async fn write_print_part(
  design : @step_cad.Design,
  path : String,
  bottom_chamfer_mm~ : Double = @cad.DEFAULT_ELEPHANT_FOOT_CHAMFER_MM,
) -> Unit {
  if design_has_boolean(design) {
    let evaluated = Some(design.to_step_evaluated()) catch { _ => None }
    match evaluated {
      Some(text) => {
        @step_cad.write_text_file(text, Some(path))
        apply_bottom_chamfer(path, chamfer_mm=bottom_chamfer_mm)
        return
      }
      None =>
        @cli.eprintln(
          "warning: OCCT evaluation failed for " +
          path +
          "; writing the nominal boolean instead",
        )
    }
  }
  @step_cad.write_text_file(design.to_step_file(), Some(path))
  apply_bottom_chamfer(path, chamfer_mm=bottom_chamfer_mm)
}

///|
/// Adds the standard output options to an example's argument spec.
pub fn with_output_args(spec : Map[String, @cli.Arg]) -> Map[String, @cli.Arg] {
  spec.set(
    "out",
    @cli.opt_string(
      short='o',
      help="Write flat STEP file to path ('-' for stdout)",
    ),
  )
  spec.set(
    "assembly",
    @cli.opt_string(help="Write hierarchical assembly STEP file to path"),
  )
  spec.set(
    "assembly-instanced",
    @cli.opt_string(
      help="Write a deduplicated, instanced hierarchical assembly STEP to path",
    ),
  )
  spec.set(
    "eval",
    @cli.opt_string(help="Write OCCT boolean-evaluated STEP file to path"),
  )
  spec.set(
    "gltf",
    @cli.opt_string(help="Write posed Z-up glTF 2.0 file to path"),
  )
  spec.set(
    "bpy",
    @cli.opt_string(help="Write Blender 5.0 Python script to path"),
  )
  spec.set(
    "blender",
    @cli.opt_string(help="Write Blender 5.0 Python script to path"),
  )
  spec.set(
    "blend",
    @cli.opt_string(help="Create .blend file via Blender CLI at path"),
  )
  spec.set(
    "urdf",
    @cli.opt_string(
      short='u',
      help="Write URDF XML file to path ('-' for stdout)",
    ),
  )
  spec.set(
    "bundle",
    @cli.opt_string(
      short='b',
      help="Write ROS 2 URDF bundle (with .gltf, .step, and printable parts) to directory",
    ),
  )
  spec.set(
    "bom",
    @cli.opt_string(help="Write bill-of-materials CSV to path ('-' for stdout)"),
  )
  spec.set(
    "plan",
    @cli.opt_string(help="Write ordered assembly plan to path ('-' for stdout)"),
  )
  spec.set(
    "report",
    @cli.opt_string(
      help="Write power/IO/wiring report to path ('-' for stdout)",
    ),
  )
  spec.set(
    "control",
    @cli.opt_string(help="Write ros2_control YAML to path ('-' for stdout)"),
  )
  spec.set(
    "pins",
    @cli.opt_string(help="Write firmware pin-map CSV to path ('-' for stdout)"),
  )
  spec.set(
    "package",
    @cli.opt_string(
      help="Write the complete build package (BOM, sourcing, printable STEP parts, control, URDF bundle) to a directory",
    ),
  )
  spec.set(
    "posed-parts",
    @cli.opt_string(
      help="Write world-posed per-link STEP files for interference analysis to directory",
    ),
  )
  spec.set(
    "print-parts",
    @cli.opt_string(
      help="Write standalone 3D-printable STEP parts and print-list.csv to directory",
    ),
  )
  spec.set(
    "detail",
    @cli.opt_string(
      help="Geometry detail level: simplified, detailed, or fully-modeled",
    ),
  )
  spec.set(
    "process",
    @cli.opt_string(
      help="Manufacturing process for DFM features: fdm, sls, cnc, or nominal (default: fdm for --package/--print-parts, nominal otherwise)",
    ),
  )
  spec.set(
    "fdm",
    @cli.flag(
      help="Shortcut for --process fdm (enable support-free FDM DFM features such as 45-degree teardrop horizontal bores)",
    ),
  )
  spec.set(
    "bedSize",
    @cli.opt_string(
      help="Print bed size WxDxH in mm for the fit check (default 220x220x250)",
    ),
  )
  spec.set(
    "threads",
    @cli.opt_string(help="Thread mode override: none, cosmetic, or helical"),
  )
  spec.set(
    "check",
    @cli.flag(help="Print assembly/hardware warnings to stderr"),
  )
  spec.set(
    "analyze",
    @cli.flag(help="Print statics, CoM, inertia, and joint torque margins"),
  )
  spec.set(
    "inspect-json",
    @cli.flag(
      help="Print a JSON summary of mass, pose, torque margins, printable parts, and interference",
    ),
  )
  spec.set(
    "rl-task",
    @cli.flag(
      help="Print the component's RL observation/action/reward contract as JSON",
    ),
  )
  spec.set(
    "collisions",
    @cli.flag(help="Analyze placed parts for unintended overlaps"),
  )
  spec.set(
    "validate",
    @cli.flag(
      help="Run scripts/validate_step.py --no-mesh and validate_urdf.py on the generated STEP and URDF",
    ),
  )
  spec.set(
    "validate-meshes",
    @cli.flag(
      help="With --validate, also check the URDF bundle meshes (requires --bundle)",
    ),
  )
  spec
}

///|
/// Collects the standard output values from parsed arguments.
pub fn output_paths(args : @cli.Args) -> OutputPaths {
  {
    step: args.string_opt("out"),
    assembly: args.string_opt("assembly"),
    assembly_instanced: args.string_opt("assembly-instanced"),
    eval: args.string_opt("eval"),
    gltf: args.string_opt("gltf"),
    bpy: args.string_opt("bpy"),
    blender: args.string_opt("blender"),
    blend: args.string_opt("blend"),
    urdf: args.string_opt("urdf"),
    bundle: args.string_opt("bundle"),
    bom: args.string_opt("bom"),
    plan: args.string_opt("plan"),
    report: args.string_opt("report"),
    control: args.string_opt("control"),
    pins: args.string_opt("pins"),
    build_package: args.string_opt("package"),
    print_parts: args.string_opt("print-parts"),
    posed_parts: args.string_opt("posed-parts"),
    detail: args.string_opt("detail").unwrap_or("simplified"),
    process: args.string_opt("process").unwrap_or(""),
    fdm: args.flag("fdm"),
    threads: args.string_opt("threads").unwrap_or(""),
    bed_size: args.string_opt("bedSize").unwrap_or(""),
    check: args.flag("check"),
    analyze: args.flag("analyze"),
    inspect_json: args.flag("inspect-json"),
    rl_task: args.flag("rl-task"),
    collisions: args.flag("collisions"),
    validate: args.flag("validate"),
    validate_meshes: args.flag("validate-meshes"),
  }
}

///|
/// Parses the `--detail` flag, aborting on an invalid value.
pub fn OutputPaths::detail_level(
  self : OutputPaths,
) -> @step_common.DetailLevel {
  match @cad.parse_detail_level(self.detail) {
    Some(level) => level
    None =>
      abort(
        "error: invalid --detail '" +
        self.detail +
        "' (expected simplified, detailed, or fully-modeled)",
      )
  }
}

///|
/// Resolves the manufacturing process from `--process` / `--fdm`, defaulting to
/// `Fdm` for printable exports (`--package` or `--print-parts`) and `Nominal`
/// otherwise. Aborts on an invalid `--process` value.
pub fn OutputPaths::mfg_process(self : OutputPaths) -> @step_common.MfgProcess {
  if self.process != "" {
    match @step_common.MfgProcess::parse(self.process) {
      Some(proc) => return proc
      None =>
        abort(
          "error: invalid --process '" +
          self.process +
          "' (expected fdm, sls, cnc, or nominal)",
        )
    }
  }
  if self.fdm || self.build_package is Some(_) || self.print_parts is Some(_) {
    @step_common.MfgProcess::Fdm
  } else {
    @step_common.MfgProcess::Nominal
  }
}

///|
/// Parses `--bedSize WxDxH`, falling back to the 220 x 220 x 250 mm default.
pub fn OutputPaths::print_bed(self : OutputPaths) -> @cad.PrintBedSpec {
  if self.bed_size == "" {
    return @cad.PrintBedSpec::default()
  }
  match @cad.PrintBedSpec::parse(self.bed_size) {
    Some(bed) => bed
    None =>
      abort(
        "error: invalid --bedSize '" +
        self.bed_size +
        "' (expected WxDxH in mm, e.g. 220x220x250)",
      )
  }
}

///|
/// Parses the `--threads` flag, returning `None` when it was not given.
pub fn OutputPaths::thread_rep(
  self : OutputPaths,
) -> @step_common.ThreadRepresentation? {
  if self.threads == "" {
    return None
  }
  match @cad.parse_thread_rep(self.threads) {
    Some(rep) => Some(rep)
    None =>
      abort(
        "error: invalid --threads '" +
        self.threads +
        "' (expected none, cosmetic, or helical)",
      )
  }
}

///|
fn any_output(output : OutputPaths) -> Bool {
  output.step is Some(_) ||
  output.assembly is Some(_) ||
  output.assembly_instanced is Some(_) ||
  output.eval is Some(_) ||
  output.gltf is Some(_) ||
  output.bpy is Some(_) ||
  output.blender is Some(_) ||
  output.blend is Some(_) ||
  output.urdf is Some(_) ||
  output.bundle is Some(_) ||
  output.bom is Some(_) ||
  output.plan is Some(_) ||
  output.report is Some(_) ||
  output.control is Some(_) ||
  output.pins is Some(_) ||
  output.build_package is Some(_) ||
  output.print_parts is Some(_) ||
  output.posed_parts is Some(_) ||
  output.analyze ||
  output.inspect_json ||
  output.rl_task ||
  output.collisions ||
  output.validate ||
  output.validate_meshes
}

///|
/// True when any output writes a file (everything except stdout-only
/// summaries such as `--analyze` and `--inspect-json`).
fn has_file_output(output : OutputPaths) -> Bool {
  output.step is Some(_) ||
  output.assembly is Some(_) ||
  output.assembly_instanced is Some(_) ||
  output.eval is Some(_) ||
  output.gltf is Some(_) ||
  output.bpy is Some(_) ||
  output.blender is Some(_) ||
  output.blend is Some(_) ||
  output.urdf is Some(_) ||
  output.bundle is Some(_) ||
  output.bom is Some(_) ||
  output.plan is Some(_) ||
  output.report is Some(_) ||
  output.control is Some(_) ||
  output.pins is Some(_) ||
  output.build_package is Some(_) ||
  output.print_parts is Some(_) ||
  output.posed_parts is Some(_) ||
  output.collisions ||
  output.validate ||
  output.validate_meshes
}

///|
fn analysis_number(value : Double) -> String {
  let rounded = (value * 1000.0).round() / 1000.0
  rounded.to_string()
}

///|
/// Prints the whole-robot statics table to stdout.
fn print_robot_analysis(analysis : @cad.RobotAnalysis) -> Unit {
  println("Robot analysis: " + analysis_number(analysis.total_mass_kg) + " kg")
  for pose in analysis.poses {
    println(
      "Pose '" +
      pose.name +
      "': CoM (" +
      analysis_number(pose.com_m.0) +
      ", " +
      analysis_number(pose.com_m.1) +
      ", " +
      analysis_number(pose.com_m.2) +
      ") m, Iyy " +
      analysis_number(pose.inertia.iyy) +
      " kg m^2",
    )
    println(
      "  joint                     tau_static   tau_rated   safety   status",
    )
    for joint in pose.joints {
      println(
        "  " +
        joint.joint +
        "  " +
        analysis_number(joint.tau_static_nm) +
        "  " +
        analysis_number(joint.tau_rated_nm) +
        "  " +
        (if joint.passive { "-" } else { analysis_number(joint.safety_factor) }) +
        "  " +
        (if joint.passive {
          "PASSIVE"
        } else if joint.ok {
          "OK"
        } else {
          "LOW"
        }),
      )
    }
    for contact in pose.contacts {
      println(
        "  contact '" +
        contact.name +
        "' min z " +
        analysis_number(contact.min_z_m) +
        " m",
      )
    }
    if pose.contact_misalignment_m > 0.0 {
      println(
        "  contact misalignment " +
        analysis_number(pose.contact_misalignment_m * 1000.0) +
        " mm",
      )
    }
  }
  for warning in analysis.warnings {
    println("warning: " + warning)
  }
}

///|
fn stdout_path(path : String?) -> String? {
  match path {
    Some(p) => if p == "-" { None } else { Some(p) }
    None => None
  }
}

///|
/// Loads the shared supplier catalog and overlays the example's own
/// `supplier-links.txt` when one is present.
///
/// The catalog lives at `catalog/suppliers.txt` relative to the repository
/// root, so examples keep one shared default mapping while still being able to
/// override a supplier, URL, note, or cost locally.
pub async fn load_supplier_links(
  example_dir : String,
) -> Array[@cad.SupplierLink] {
  let catalog_text = @fs.read_file("catalog/suppliers.txt").text() catch {
    _ => ""
  }
  let example_text = if example_dir == "" {
    ""
  } else {
    @fs.read_file(example_dir + "/supplier-links.txt").text() catch {
      _ => ""
    }
  }
  @cad.merge_supplier_links(
    @cad.parse_supplier_links(catalog_text),
    @cad.parse_supplier_links(example_text),
  )
}

///|
/// Validates the component's robot, then writes every requested output.
///
/// When `example_dir` is given, the shared supplier catalog and that example's
/// `supplier-links.txt` are applied before any output is written.
pub async fn write_output(
  comp : @cad.Component,
  output : OutputPaths,
  joint_positions~ : Map[String, Double] = Map([]),
  example_dir~ : String = "",
) -> Unit {
  let comp = if example_dir == "" {
    comp
  } else {
    comp.with_supplier_links(load_supplier_links(example_dir))
  }
  let robot = comp.to_robot()
  if robot.has_errors() {
    for diagnostic in robot.diagnostics() {
      if diagnostic.severity().is_error() {
        @cli.eprintln("error: " + diagnostic.message())
      }
    }
    abort("")
  }
  if output.collisions {
    let reports = comp.collision_reports(joint_positions~)
    let mut collisions = 0
    let mut contacts = 0
    let mut fits = 0
    let mut indeterminate = 0
    for report in reports {
      match report.kind {
        @step_collision.CollisionKind::Collision => {
          collisions = collisions + 1
          @cli.eprintln("collision: " + report.summary())
        }
        @step_collision.CollisionKind::Contact => contacts = contacts + 1
        @step_collision.CollisionKind::InterferenceFit => fits = fits + 1
        @step_collision.CollisionKind::Indeterminate => {
          indeterminate = indeterminate + 1
          @cli.eprintln("indeterminate: " + report.summary())
        }
        @step_collision.CollisionKind::Clearance => ()
      }
    }
    @cli.eprintln(
      "collision analysis: " +
      collisions.to_string() +
      " collision(s), " +
      contacts.to_string() +
      " contact(s), " +
      fits.to_string() +
      " declared fit(s), " +
      indeterminate.to_string() +
      " indeterminate",
    )
  }
  let bed = output.print_bed()
  if output.inspect_json && output.build_package is None {
    println(comp.inspect_json(bed~, joint_positions~))
  }
  if output.rl_task {
    match comp.rl_task {
      Some(_) =>
        if output.build_package is None {
          println(comp.rl_task_json(joint_positions~))
        }
      None => {
        @cli.eprintln("error: this component has no RL task")
        abort("")
      }
    }
  }
  if output.analyze {
    print_robot_analysis(
      @cad.analyze_robot(comp, [("default", joint_positions)]),
    )
    if !has_file_output(output) && !output.check && !output.collisions {
      return
    }
  }
  if output.check {
    let warnings = comp.assembly_checks(bed~)
    for warning in warnings {
      @cli.eprintln("warning: " + warning)
    }
    let control_warnings = comp.control_checks()
    for warning in control_warnings {
      @cli.eprintln("warning: " + warning)
    }
    let harness_warnings = comp.harness_checks()
    for warning in harness_warnings {
      @cli.eprintln("warning: " + warning)
    }
    let wiring_warnings = comp.wiring_checks()
    for warning in wiring_warnings {
      @cli.eprintln("warning: " + warning)
    }
    @cli.eprintln(
      "hardware checks: " +
      (warnings.length() +
      control_warnings.length() +
      harness_warnings.length() +
      wiring_warnings.length()).to_string() +
      " warning(s)",
    )
  }
  if !any_output(output) {
    if output.collisions {
      let reports = comp.collision_reports(joint_positions~)
      let mut collisions = 0
      let mut contacts = 0
      let mut fits = 0
      let mut indeterminate = 0
      for report in reports {
        match report.kind {
          @step_collision.CollisionKind::Collision => {
            collisions = collisions + 1
            @cli.eprintln("collision: " + report.summary())
          }
          @step_collision.CollisionKind::Contact => contacts = contacts + 1
          @step_collision.CollisionKind::InterferenceFit => fits = fits + 1
          @step_collision.CollisionKind::Indeterminate => {
            indeterminate = indeterminate + 1
            @cli.eprintln("indeterminate: " + report.summary())
          }
          @step_collision.CollisionKind::Clearance => ()
        }
      }
      @cli.eprintln(
        "collision analysis: " +
        collisions.to_string() +
        " collision(s), " +
        contacts.to_string() +
        " contact(s), " +
        fits.to_string() +
        " declared fit(s), " +
        indeterminate.to_string() +
        " indeterminate",
      )
    }
    if output.check {
      return
    }
    comp.to_design(joint_positions~).write_step_file(None)
    return
  }
  let raw_design = comp.to_design(joint_positions~)
  let design = raw_design.with_documentation(
    build_step_documentation(comp, raw_design.documentation),
  )
  match output.step {
    Some(_) => design.write_step_file(stdout_path(output.step))
    None => ()
  }
  match output.assembly {
    Some(_) =>
      @step_cad.write_text_file(
        design.to_assembly_step(assembly_name=comp.display_name()),
        stdout_path(output.assembly),
      )
    None => ()
  }
  match output.assembly_instanced {
    Some(_) =>
      @step_cad.write_text_file(
        design.to_instanced_step_string(assembly_name=comp.display_name()),
        stdout_path(output.assembly_instanced),
      )
    None => ()
  }
  match output.eval {
    Some(path) => design.write_step_evaluated(Some(path))
    None => ()
  }
  match output.gltf {
    Some(path) => @cad.gltf_safe_design(design).to_gltf_file(Some(path))
    None => ()
  }
  match output.bpy {
    Some(path) => design.write_blender_python(Some(path))
    None => ()
  }
  match output.blender {
    Some(path) => design.write_blender_python(Some(path))
    None => ()
  }
  match output.blend {
    Some(path) => design.create_blender_file(path)
    None => ()
  }
  match output.urdf {
    Some(_) => robot.write_urdf(stdout_path(output.urdf), checked=true)
    None => ()
  }
  match output.bundle {
    Some(dir) =>
      comp.to_urdf_bundle(joint_positions~).write_to_dir(dir, checked=true)
    None => ()
  }
  match output.bom {
    Some(_) =>
      @step_cad.write_text_file(comp.to_bom_csv(), stdout_path(output.bom))
    None => ()
  }
  match output.plan {
    Some(_) =>
      @step_cad.write_text_file(
        comp.assembly_plan_text(),
        stdout_path(output.plan),
      )
    None => ()
  }
  match output.report {
    Some(_) =>
      @step_cad.write_text_file(comp.report_text(), stdout_path(output.report))
    None => ()
  }
  match output.control {
    Some(_) =>
      @step_cad.write_text_file(
        comp.to_ros2_control_yaml(),
        stdout_path(output.control),
      )
    None => ()
  }
  match output.pins {
    Some(_) =>
      @step_cad.write_text_file(comp.to_pin_map_csv(), stdout_path(output.pins))
    None => ()
  }
  match output.posed_parts {
    Some(dir) => {
      @fs.mkdir(dir, recursive=true, allow_exist=true)
      let (links, _, _) = comp.compile_links()
      let fk = robot.forward_kinematics(joint_positions~)
      for link in links {
        let world = fk.get(link.name).unwrap_or(@urdf.Transform::identity())
        let mut design = @step_cad.Design::new(name=link.name)
        for body in link.bodies {
          design = design.add(
            @cad.transform_scene_node_urdf(body.node, world).with_name(
              link.name + "_" + body.name,
            ),
          )
        }
        design.write_step_file(Some(dir + "/" + link.name + ".step"))
      }
    }
    None => ()
  }
  match output.print_parts {
    Some(dir) => {
      @fs.mkdir(dir, recursive=true, allow_exist=true)
      for part in comp.printable_parts() {
        let part_design = part.design.with_documentation(
          build_step_documentation(comp, part.design.documentation),
        )
        write_print_part(
          part_design,
          dir + "/" + @cad.sanitize_part_number(part.part_number) + ".step",
        )
      }
      @step_cad.write_text_file(
        comp.print_list_csv(bed~),
        Some(dir + "/print-list.csv"),
      )
      write_provenance_json(dir, comp)
    }
    None => ()
  }
  match output.build_package {
    Some(dir) => {
      @fs.mkdir(dir, recursive=true, allow_exist=true)
      // Remove stale printable STEPs from earlier configurations before rewriting.
      @fs.rmdir(dir + "/printable", recursive=true) catch {
        _ => ()
      }
      @fs.mkdir(dir + "/printable", recursive=true, allow_exist=true)
      write_provenance_json(dir, comp)
      let written : Array[String] = []
      for file in comp.build_package_files(bed~, joint_positions~) {
        @step_cad.write_text_file(file.content, Some(dir + "/" + file.path))
        written.push(file.path)
      }
      for part in comp.printable_parts() {
        let rel = "printable/" +
          @cad.sanitize_part_number(part.part_number) +
          ".step"
        if written.contains(rel) {
          if design_has_boolean(part.design) {
            write_print_part(part.design, dir + "/" + rel)
          } else {
            apply_bottom_chamfer(dir + "/" + rel)
          }
        }
      }
      if design.nodes.length() > 1 && !design_has_boolean(design) {
        @step_cad.write_text_file(
          design.to_instanced_step_string(assembly_name=comp.display_name()),
          Some(dir + "/assembly.step"),
        )
      } else {
        design.write_step_file(Some(dir + "/assembly.step"))
      }
      @cad.gltf_safe_design(design).to_gltf_file(Some(dir + "/assembly.gltf"))
      // The interactive preview: START-HERE.html loads viewer.js, which fetches
      // assembly.gltf. The static views/iso.png remains the offline fallback.
      let viewer = @fs.read_file("scripts/viewer.js").text() catch { _ => "" }
      if viewer == "" {
        @cli.eprintln(
          "warning: scripts/viewer.js is missing; START-HERE.html will use the static render",
        )
      } else {
        @step_cad.write_text_file(viewer, Some(dir + "/viewer.js"))
      }
      let preview = @fs.read_file("scripts/preview.html").text() catch {
        _ => ""
      }
      if preview != "" {
        @step_cad.write_text_file(preview, Some(dir + "/preview.html"))
      }
      // First-class exploded view: whenever the tree declares any
      // `ExplodeSpec`, write the exploded, role-colored STEP automatically.
      if comp.has_explode_spec() {
        let raw_exp = comp.to_exploded_design(
          joint_positions~,
          trace_lines=true,
        )
        let exp_design = raw_exp.with_documentation(
          build_step_documentation(comp, raw_exp.documentation),
        )
        if exp_design.nodes.length() > 1 && !design_has_boolean(exp_design) {
          @step_cad.write_text_file(
            exp_design.to_instanced_step_string(
              assembly_name=comp.display_name() + " (Exploded)",
            ),
            Some(dir + "/exploded.step"),
          )
        } else {
          exp_design.write_step_file(Some(dir + "/exploded.step"))
        }
      }
      comp
      .to_urdf_bundle(joint_positions~)
      .write_to_dir(dir + "/bundle", checked=true)
    }
    None => ()
  }
  if output.validate || output.validate_meshes {
    let tag = comp.name.replace(old=" ", new="-")
    let mut temp_step = false
    let step_path = match output.step {
      Some(path) =>
        if path == "-" {
          @cli.eprintln(
            "error: --validate cannot check a STEP stream on stdout",
          )
          abort("")
        } else {
          path
        }
      None => {
        temp_step = true
        "/tmp/" + tag + ".validate.step"
      }
    }
    if temp_step {
      design.write_step_file(Some(step_path))
    }
    @cli.eprintln(
      "validate: scripts/validate_step.py " + step_path + " --no-mesh",
    )
    let step_code = @process.run("python3", [
      "scripts/validate_step.py", step_path, "--no-mesh",
    ])
    if step_code != 0 {
      if temp_step {
        @fs.remove(step_path, allow_missing=true)
      }
      @cli.eprintln("error: STEP validation failed")
      abort("")
    }
    let mut temp_urdf = false
    let urdf_path = if output.validate_meshes {
      match output.bundle {
        Some(dir) => dir + "/urdf/" + robot.name + ".urdf"
        None => {
          @cli.eprintln(
            "error: --validate-meshes needs --bundle <dir> so the meshes exist",
          )
          abort("")
        }
      }
    } else {
      match output.urdf {
        Some(path) =>
          if path == "-" {
            @cli.eprintln(
              "error: --validate cannot check a URDF stream on stdout",
            )
            abort("")
          } else {
            path
          }
        None => {
          temp_urdf = true
          "/tmp/" + tag + ".validate.urdf"
        }
      }
    }
    if temp_urdf {
      robot.write_urdf(Some(urdf_path), checked=true)
    }
    let urdf_args : Array[String] = ["scripts/validate_urdf.py", urdf_path]
    if output.validate_meshes {
      urdf_args.push("--check-meshes")
    }
    @cli.eprintln("validate: python3 " + urdf_args.join(" "))
    let urdf_code = @process.run("python3", urdf_args)
    if temp_step {
      @fs.remove(step_path, allow_missing=true)
    }
    if temp_urdf {
      @fs.remove(urdf_path, allow_missing=true)
    }
    if urdf_code != 0 {
      @cli.eprintln("error: URDF validation failed")
      abort("")
    }
  }
}
