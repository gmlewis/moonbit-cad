  route : CableRoute
}

pub(all) enum SensorKind {
  LimitSwitch
  Encoder
  Imu
  Camera
  Force
}

pub(all) struct SensorLine {
  path : String
  spec : SensorSpec
}

pub(all) struct SensorSpec {
  kind : SensorKind
  model : String
  interface : String
  voltage_v : Double
  current_ma : Double
  range : String
  resolution : String
}
pub fn SensorSpec::new(SensorKind, model? : String, interface? : String, voltage_v? : Double, current_ma? : Double, range? : String, resolution? : String) -> Self

pub(all) struct SupplierLink {
  part_number : String
  supplier : String
  supplier_url : String
  notes : String
  unit_cost_usd : Double?
}
pub fn SupplierLink::new(part_number~ : String, supplier? : String, supplier_url? : String, notes? : String, unit_cost_usd? : Double) -> Self

pub(all) enum VisualMode {
  Primitives
  MeshPackage(String)
}

pub(all) struct WireLine {
  path : String
  run : WireRun
}

pub(all) struct WireRun {
  name : String
  from_component : String
  from_port : String
  to_component : String
  to_port : String
  gauge_awg : Int32
  length_mm : Double
  notes : String
}
pub fn WireRun::new(String, from_component~ : String, from_port~ : String, to_component~ : String, to_port~ : String, gauge_awg? : Int32, length_mm? : Double, notes? : String) -> Self

