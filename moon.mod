name = "gmlewis/cad"

version = "0.2.5"

import {
  "gmlewis/step@0.2.5",
  "gmlewis/urdf@0.2.5",
  "moonbitlang/async@0.22.9",
}

readme = "README.md"

repository = "https://github.com/gmlewis/moonbit-19-cad"

license = "Apache-2.0"

keywords = [ "cad", "step", "urdf", "robotics", "3d-modeling" ]

description = "Pluggable parametric CAD and URDF robotics component library in MoonBit"

preferred_target = "native"
